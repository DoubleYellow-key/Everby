{
  "name": "everby",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Everby contributors",
  "type": "module",
  "description": "A private, local-first desktop companion powered by your own model API.",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "agent:test": "node scripts/python-agent.mjs test",
    "agent:schema": "node scripts/python-agent.mjs schema",
    "agent:build": "node scripts/python-agent.mjs build",
    "agent:smoke": "tsx scripts/smoke-agent.ts",
    "dist:win": "node scripts/python-agent.mjs build x64 win32 && pnpm build && electron-builder --win nsis portable --x64",
    "dist:mac": "pnpm run dist:mac:arm64",
    "dist:mac:arm64": "node scripts/python-agent.mjs build arm64 darwin && pnpm build && electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "node scripts/python-agent.mjs build x64 darwin && pnpm build && electron-builder --mac dmg zip --x64",
    "motion:build": "tsx scripts/build-motion.ts",
    "motion:validate": "tsx scripts/validate-motion.ts",
    "motion:example": "tsx scripts/create-example-motion.ts && tsx scripts/build-motion.ts examples/motions/daily-routines/motion.json examples/motions/daily-routines.soulmotion",
    "assets:placeholder": "tsx scripts/create-placeholder.ts"
  },
  "build": {
    "appId": "app.everby.companion",
    "productName": "Everby",
    "asar": true,
    "asarUnpack": [
      "node_modules/get-windows/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": ["out/**", "package.json"],
    "extraResources": [
      { "from": "resources/runtime-pets", "to": "pets" },
      { "from": "agent-dist", "to": "agent" },
      { "from": "examples/motions/daily-routines.soulmotion", "to": "motion-examples/daily-routines.soulmotion" },
      { "from": "build/icon.png", "to": "app-icon.png" }
    ],
    "directories": { "buildResources": "build", "output": "release" },
    "win": { "icon": "icon.png", "target": ["nsis", "portable"] },
    "mac": { "icon": "icon.png", "category": "public.app-category.lifestyle", "target": ["dmg", "zip"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "get-windows": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.35.3",
    "@img/sharp-darwin-x64": "^0.35.3",
    "@img/sharp-libvips-darwin-arm64": "^1.3.2",
    "@img/sharp-libvips-darwin-x64": "^1.3.2",
    "@img/sharp-win32-x64": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
